#!/usr/bin/env python
# Build script for the RuntimeProtector Windows x64 GDExtension.
#
# Requires godot-cpp matching the target Godot version.

env = SConscript("godot-cpp/SConstruct")

if env["platform"] != "windows" or env["arch"] != "x86_64":
    raise RuntimeError("RuntimeProtector signature verification currently supports Windows x64 only")

env.Append(CPPPATH=["src/", "src/third_party/"])
env.Append(LIBS=["psapi", "wintrust", "crypt32"])

sources = Glob("src/*.cpp") + Glob("src/third_party/*.c")
library = env.SharedLibrary(
    "bin/libruntimeprotector{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
