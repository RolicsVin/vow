[configuration]
entry_symbol = "runtime_protector_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://addons/runtime_protector/bin/libruntimeprotector.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/runtime_protector/bin/libruntimeprotector.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/runtime_protector/bin/libruntimeprotector.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/runtime_protector/bin/libruntimeprotector.linux.template_release.x86_64.so"
macos.debug = "res://addons/runtime_protector/bin/libruntimeprotector.macos.template_debug.framework"
macos.release = "res://addons/runtime_protector/bin/libruntimeprotector.macos.template_release.framework"