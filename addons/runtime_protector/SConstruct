#!/usr/bin/env python
# Build script for the RuntimeProtector GDExtension.
#
# Prerequisite: godot-cpp must be present as a subfolder (or submodule)
# named "godot-cpp" next to this file, built against the same Godot
# major.minor version you intend to run the extension on. See README.md.

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

if env["platform"] == "windows":
    env.Append(LIBS=["psapi"])

if env["platform"] == "linux":
    env.Append(CXXFLAGS=["-pthread"])
    env.Append(LINKFLAGS=["-pthread"])

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libruntimeprotector.{}.{}.framework/libruntimeprotector.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libruntimeprotector{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)
